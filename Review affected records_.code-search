  45  function qualityItems(){const checks=[['Missing Version ID',r=>!r['Version ID']],['Missing Product ID',r=>!r['Primary Product ID']],['Missing Manufacturer',r=>!r['Manufacturer Name']],['Missing Test Report ID',r=>!r['Lab 1 Test Report ID']],['Missing Component Description',r=>!r['Lab 1 Component Description']],['Missing Lab Name',r=>!r['Lab 1 Name']],['Invalid Test Date',r=>r['Last Test Date']&&isNaN(new Date(r['Last Test Date']))],['Unexpected Exclusion',r=>r['Testing Exclusions']&&!['1610.1(d)(1)','1610.1(d)(2)'].includes(r['Testing Exclusions'])]];const dups=new Set(rows.map(r=>r['Primary Product ID']).filter((v,i,a)=>v&&a.indexOf(v)!==i));checks.push(['Duplicate Product ID Records',r=>dups.has(r['Primary Product ID'])]);const vd=new Set(rows.map(r=>r['Version ID']).filter((v,i,a)=>v&&a.indexOf(v)!==i));checks.push(['Duplicate Version ID Records',r=>vd.has(r['Version ID'])]);return checks.map(([name,fn])=>({name,rows:rows.filter(fn)}))}
  46: function renderQuality(){const items=qualityItems();document.getElementById('qualityCards').innerHTML=items.map(x=>`<div class="quality"><strong>${x.rows.length}</strong><h3>${esc(x.name)}</h3><p>${x.rows.length?'Review affected records.':'No exception found.'}</p></div>`).join('');const exceptions=[];items.forEach(x=>x.rows.forEach(r=>exceptions.push({...r,'Quality Issue':x.name})));simpleTable('qualityTable',exceptions,['Quality Issue','Version ID','Primary Product ID','Product Name (Model)','Manufacturer Name','Lab 1 Test Report ID'])}
  47  function renderAll(){document.getElementById('fileName').textContent=currentFile;document.getElementById('fileMeta').textContent=rows.length+' rows · '+Object.keys(rows[0]||{}).length+' columns · refreshed '+new Date().toLocaleString();renderOverview();setupFilters('master',rows);setupFilters('tested',rows.filter(isTested));simpleTable('manufacturerTable',summaryRows('Manufacturer Name','Manufacturer'),['Manufacturer','Product Versions','Tested Count','Exclusion Count','Unique Reports','Latest Test Date']);simpleTable('labTable',summaryRows('Lab 1 Name','Laboratory'),['Laboratory','Product Versions','Tested Count','Exclusion Count','Unique Reports','Latest Test Date']);renderQuality()}
